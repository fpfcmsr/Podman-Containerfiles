# You can find documentation for all the supported env variables at https://immich.app/docs/install/env>

# Connection secret for postgres. You should change it to a random password.
# The two values should match
DB_PASSWORD=supergoodpassword
POSTGRES_PASSWORD=evenbetterpassword

# if your database isn't stored on SSDs
#DB_STORAGE_TYPE=HDD

# The values below this line do not need to be changed
###################################################################################

DB_HOSTNAME=immich-postgres
DB_USERNAME=postgres
POSTGRES_USER=postgres

DB_DATABASE_NAME=immich
POSTGRES_DB=immich

REDIS_HOSTNAME=immich-redis

IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003
